# PUBLIC: Firebase Web App configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SERVER ONLY: never use VITE_ for payment or Admin secrets.
APP_URL=https://flash-sitasi.vercel.app
# New purchases use DOKU Checkout, restricted to QRIS.
PAYMENT_PROVIDER=doku
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# production for real payments; sandbox payments NEVER grant credits or badges.
DOKU_ENVIRONMENT=production

# Keep these only to verify/reconcile existing bayar.gg invoices.
BAYAR_GG_API_KEY=
BAYAR_GG_WEBHOOK_SECRET=
BAYAR_GG_CHECKOUT_URL=https://www.bayar.gg/pay
BAYAR_GG_PAYMENT_METHOD=

# Option A: a complete Firebase service account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=
# Option B: these three variables instead of FIREBASE_SERVICE_ACCOUNT.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SERVER ONLY: Firebase Authentication UID(s) of the primary owner, comma-separated.
# Owners are admins and cannot be demoted/blocked from the dashboard.
ADMIN_OWNER_UIDS=
